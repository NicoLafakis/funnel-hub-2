{
  "name": "flywheel-v2",
  "version": "0.1.0",
  "description": "Flywheel V2 — 3D city eater rebuild per the .wiki design docs. Three.js, no bundler, no backend.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "test": "node scripts/logic-test.js && node scripts/invariant-test.js",
    "test:district-objects": "node scripts/district-object-report.js",
    "test:e2e": "node scripts/smoke-test.cjs && node scripts/flow-test.cjs",
    "test:golden": "node scripts/golden-test.cjs",
    "test:play": "node scripts/play-bot.cjs",
    "ship": "node scripts/ship.js",
    "models": "\"C:/Program Files/Blender Foundation/Blender 5.1/blender.exe\" -b --factory-startup --python scripts/blender/build_props.py && node scripts/glb-to-js.js",
    "vendor-three": "node scripts/vendor-three.js",
    "postinstall": "node scripts/vendor-three.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "three": "^0.185.0"
  }
}
